{
  "name": "linkedin-scrapper",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright scraper for LinkedIn connections, profiles, messaging, and follow-ups",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "login": "node src/login.js",
    "scrape": "node src/scrape-connections.js",
    "rag:rebuild": "node -e \"require('./src/rag/index').buildIndex()\"",
    "mongo:up": "docker compose up -d mongo",
    "mongo:down": "docker compose down",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f app",
    "postinstall": "npx playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "mongodb": "^6.21.0",
    "playwright": "^1.55.0"
  }
}
