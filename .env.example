# Server
PORT=6363

# Local MongoDB (host). Docker Compose overrides to mongodb://mongo:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=linkedin_scrapper

# Browser
HEADLESS=false
ACTION_DELAY_MS=3000

# AI — Claude preferred (put real key only in .env — never commit it)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MESSAGES=true

# RAG (knowledge/*.md) — index TTL 1 day
RAG_TTL_MS=86400000
RAG_TOP_K=4
RAG_MIN_SCORE=60

# Messaging is AI + queue from the UI (SEND_MESSAGES kept false)
SEND_MESSAGES=false
